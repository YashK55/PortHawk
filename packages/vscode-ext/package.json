{
  "name": "porthawk-vscode",
  "displayName": "PortHawk",
  "description": "See every listening port on your machine and kill what shouldn't still be running",
  "version": "0.1.5",
  "publisher": "YashK55",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/YashK55/PortHawk.git"
  },
  "type": "module",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "port",
    "server",
    "localhost",
    "process manager",
    "netstat",
    "kill port",
    "dev server"
  ],
  "activationEvents": [
    "onView:porthawkPorts"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "porthawk",
          "title": "PortHawk",
          "icon": "media/activity-bar-icon.svg"
        }
      ]
    },
    "views": {
      "porthawk": [
        {
          "id": "porthawkPorts",
          "name": "Listening Ports"
        }
      ]
    },
    "commands": [
      {
        "command": "porthawk.refresh",
        "title": "Refresh",
        "category": "PortHawk",
        "icon": "$(refresh)"
      },
      {
        "command": "porthawk.killProcess",
        "title": "Kill Process",
        "category": "PortHawk",
        "icon": "$(debug-stop)"
      },
      {
        "command": "porthawk.openInBrowser",
        "title": "Open in Browser",
        "category": "PortHawk",
        "icon": "$(globe)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "porthawk.refresh",
          "when": "view == porthawkPorts",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "porthawk.openInBrowser",
          "when": "view == porthawkPorts && viewItem == portEntry",
          "group": "inline"
        },
        {
          "command": "porthawk.killProcess",
          "when": "view == porthawkPorts && viewItem == portEntry",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "PortHawk",
      "properties": {
        "porthawk.refreshInterval": {
          "type": "number",
          "default": 3000,
          "minimum": 500,
          "description": "How often to re-scan listening ports, in milliseconds, while the PortHawk view is visible."
        },
        "porthawk.autoTagAgentProcesses": {
          "type": "boolean",
          "default": true,
          "description": "Tag ports likely opened by an AI coding agent's terminal with a distinct icon."
        },
        "porthawk.notifyOnNewOrphanedServer": {
          "type": "boolean",
          "default": false,
          "description": "Show a notification when a new likely agent-spawned server is detected."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "tsc --noEmit && eslint src && node esbuild.js",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch",
    "watch": "npm-run-all2 -p watch:*",
    "package": "tsc --noEmit && eslint src && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile",
    "test": "vscode-test",
    "build": "node esbuild.js --production",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "porthawk-core": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.1",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.3",
    "npm-run-all2": "^9.0.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "license": "MIT"
}
