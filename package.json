{
  "name": "porthawk-workspace",
  "private": true,
  "description": "Monorepo root for the PortHawk CLI, VS Code extension, and shared core engine",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm --filter=./packages/core --filter=./packages/cli run test",
    "typecheck": "pnpm -r run typecheck",
    "changeset": "changeset"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.17.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@changesets/cli": "^2.31.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YashK55/porthawk-vscode.git"
  }
}
