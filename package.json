{
  "name": "portwatch-workspace",
  "private": true,
  "description": "Monorepo root for the PortWatch CLI, VS Code extension, and shared core engine",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm --filter=./packages/core --filter=./packages/cli run test",
    "typecheck": "pnpm -r run typecheck"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.17.0",
      "onFail": "download"
    }
  },
  "type": "module"
}
